diff --git a/dma.cpp b/dma.cpp
index e1ad324..84007f7 100644
--- a/dma.cpp
+++ b/dma.cpp
@@ -22,6 +22,23 @@ extern SPC7110	s7emu;
 
 static uint8	sdd1_decode_buffer[0x10000];
 
+void MomotaroTraceRead(const uint8 *source, uint32 value, uint32 size)
+{
+	static FILE *trace = getenv("MOMOTARO_TRACE") ? fopen(getenv("MOMOTARO_TRACE"), "wb") : nullptr;
+	const uintptr_t offset = reinterpret_cast<uintptr_t>(source) - reinterpret_cast<uintptr_t>(Memory.ROM);
+	if (trace && offset < 0x200000)
+	{
+		const uint32 record[] = {Registers.PBPC, static_cast<uint32>(offset), value, size};
+		fwrite(record, sizeof(record), 1, trace);
+	}
+	const uintptr_t ramOffset = reinterpret_cast<uintptr_t>(source) - reinterpret_cast<uintptr_t>(Memory.RAM);
+	if (trace && ramOffset < 0x20000 && (Registers.PBPC == 0x80bd30 || Registers.PBPC == 0x849e59))
+	{
+		const uint32 record[] = {Registers.PBPC, static_cast<uint32>(0x7e0000 + ramOffset), value, size};
+		fwrite(record, sizeof(record), 1, trace);
+	}
+}
+
 static inline bool8 addCyclesInDMA (uint8);
 static inline bool8 HDMAReadLineCount (int);
 
